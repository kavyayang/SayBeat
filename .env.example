# This file is an example; it is NOT automatically loaded.
# TokenHub website mode reads a local .env (mode 600) solely for
# TENCENT_TOKENHUB_API_KEY; other variables must be exported to the process.
# The website re-reads the Key before each confirmed TokenHub request.
# Restart after first configuring the Key if the site started in internal gateway mode.
# Music, speech and lyric endpoints may bill; each requires an explicit per-call confirmation.
# A returned MP3 remains private/unverified; it is not a shareable official work.
# Never put a real key in this example file.
# AI_GATEWAY_URL is an internal adapter, not a vendor API URL.
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
# Comma-separated capabilities: lyrics,speech,singing
AI_GATEWAY_FEATURES=
# Set true only after provider rights/privacy and output validation are reviewed.
AI_RIGHTS_CONFIRMED=false
# No local daily song limit. Provider billing and rate limits still apply.
# Tencent Cloud TokenHub Mureka Music: use only for a private, unverified MP3 candidate.
# The candidate command requires --confirm-paid-call and --confirm-input-rights.
# Never put this real key in a committed file or in the browser.
TENCENT_TOKENHUB_API_KEY=
# Optional exported process variable (not read from .env): TOKENHUB_LYRICS_MODEL=glm-5.3-flash
# Speech model: hy-asr-3.0-preview (fixed); music model: mureka-music-v9.
# Endpoints: /v1/chat/completions and /v1/wand/asrproxy/sync_transcribe.
